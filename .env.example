# Copy to .env and fill in credentials for the provider you want to use.
# Do not commit .env or paste API keys into chat.

# DeepSeek Responses API (recommended for the real-model evaluation):
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash
# Optional; this is the official default endpoint:
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI Responses API alternative:
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=replace-with-an-enabled-model
# Optional for a compatible API endpoint:
# OPENAI_BASE_URL=https://api.example.com/v1
